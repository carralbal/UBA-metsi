  "diagrams": [
    {
      "file": "diagrams/N22-mapa-01.svg",
      "title": "Anatomía de una hipótesis",
      "labels": [
        "Población",
        "Intervención",
        "Mecanismo",
        "Resultado",
        "Umbral"
      ],
      "claim": "Anatomía de una hipótesis separa población, intervención, mecanismo, resultado, umbral para impedir que una capa oculte las obligaciones de las demás.",
      "family": "layers",
      "sha256": "c529398288576625705d85ee059400bc9cf5c69606e75d8a9875e35a23b99b78"
    }
  ],
  "quotes": [
    "Una iniciativa aprende cuando explicita mecanismo, rival, población, línea de base, salvaguardas, umbral y decisión.",
    "La refutación no autoriza a experimentar con derechos ni garantiza inferencia causal."
  ],
